Bootstrap: docker
From: ubuntu:22.04

%files
    # Copies pipeline.sh, all *.py files, and helper files in this folder to /app
    pipeline.sh /app/pipeline.sh
    scripts /app/scripts

%environment
    # Add conda and the app directory to PATH
    export CONDA_DIR=/opt/conda
    export PATH="/opt/conda/bin:/app:$PATH"
    export LC_ALL=C.UTF-8
    export PYTHONUNBUFFERED=1

%post
    # Prevent interactive tzdata/keyboard prompts
    export DEBIAN_FRONTEND=noninteractive

    # Update base system and install wget/git/ca-certificates
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        git \
        bzip2 \
    && rm -rf /var/lib/apt/lists/*

    # Download and install Miniforge
    wget -qO /tmp/miniforge.sh "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh"
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh

    # Set up PATH for conda
    export PATH="/opt/conda/bin:$PATH"

    # Install Python 3.10, MRtrix3, and scientific Python stack from pre-compiled binaries
    conda install -y -c conda-forge -c mrtrix3 \
        python=3.10 \
        mrtrix3 \
        numpy \
        scipy \
        nibabel \
        dipy \
    && conda clean -ya

    # Install dmri-commit via pip (uses pre-built cp310 manylinux wheel)
    pip install --no-cache-dir dmri-commit

    # Ensure pipeline script is executable
    chmod +x /app/pipeline.sh

%runscript
    exec /app/pipeline.sh "$@"
